rules_version = '2';

// Security rules for Big Payrolls.
// - Clients can only read and write their own profile and their own requests.
// - Clients can never make themselves admin, set a price, or record payments.
// - A client may only accept a quote or ask for changes while it is "quote_sent".
// - Admins (users/{uid}.role == "admin", set by hand in the Firebase console) can read and update everything.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'client'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      // A client may edit their profile but never their role.
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role)
        || isAdmin();

      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // New requests start as "submitted" with no quote, updates or payments.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && !('quote' in request.resource.data)
        && !('payments' in request.resource.data)
        && !('updates' in request.resource.data)
        && !('invoice' in request.resource.data)
        && !('paymentLink' in request.resource.data)
        && !('paymentClaims' in request.resource.data)
        && request.resource.data.services is list
        && request.resource.data.services.size() > 0
        && request.resource.data.services.size() <= 20;

      // Client may only: (1) accept the quote or ask for changes while it is "quote_sent",
      // or (2) add one "I have paid" claim (amount + UTR) once the quote is accepted.
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && (
          (
            resource.data.status == 'quote_sent'
            && request.resource.data.status in ['quote_accepted', 'changes_requested']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'clientResponse', 'updatedAt'])
          ) || (
            resource.data.status in ['quote_accepted', 'advance_paid', 'in_progress', 'live', 'completed']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentClaims', 'updatedAt'])
            && request.resource.data.paymentClaims is list
            && request.resource.data.paymentClaims.size() == resource.data.get('paymentClaims', []).size() + 1
            && request.resource.data.paymentClaims.size() <= 20
          )
        )
      );

      allow delete: if isAdmin();
    }

    // Payment / invoice details: any signed-in client can read them (to pay), only admins can change them.
    match /settings/business {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Invoice counters and anything else in settings: admins only.
    match /settings/{other} {
      allow read, write: if isAdmin();
    }

    // Private team notes per request. Never visible to clients.
    match /internal/{requestId} {
      allow read, write: if isAdmin();
    }

    // Enquiries from the ad landing page (/website-quote) and the short sign-up, no login needed.
    // Anyone may create one with exactly these fields; only admins can list, update or delete.
    // A brand-new enquiry can be read by its id for 15 minutes, so the team-alert function can
    // email exactly what was saved (the id is random and only the sender knows it).
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function optStr(d, k, max) {
      return !(k in d) || str(d[k], 1, max);
    }
    function validUtm(u) {
      return u is map
        && u.keys().hasOnly(['source', 'medium', 'campaign', 'content', 'term', 'fbclid', 'landing', 'referrer'])
        && optStr(u, 'source', 100) && optStr(u, 'medium', 100) && optStr(u, 'campaign', 100)
        && optStr(u, 'content', 100) && optStr(u, 'term', 100) && optStr(u, 'landing', 100) && optStr(u, 'referrer', 100)
        && (!('fbclid' in u) || u.fbclid is bool);
    }
    match /leads/{leadId} {
      allow create: if leadId.size() == 20
        && request.resource.data.keys().hasOnly(['source', 'name', 'phone', 'businessType', 'need', 'message',
             'company', 'email', 'interests', 'companySize', 'utm', 'status', 'consent', 'createdAt'])
        && request.resource.data.source in ['website-quote', 'signup']
        && str(request.resource.data.name, 1, 80)
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.status == 'new'
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time
        && (!('businessType' in request.resource.data) || request.resource.data.businessType in ['Shop', 'Restaurant', 'Clinic', 'Startup', 'Services', 'Other'])
        && (!('need' in request.resource.data) || request.resource.data.need in ['Business website', 'Online shop', 'Landing page', 'Not sure'])
        && (request.resource.data.source != 'website-quote' || ('businessType' in request.resource.data && 'need' in request.resource.data))
        && optStr(request.resource.data, 'message', 1000)
        && optStr(request.resource.data, 'company', 100)
        && optStr(request.resource.data, 'email', 120)
        && optStr(request.resource.data, 'companySize', 20)
        && (!('interests' in request.resource.data) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 10))
        && (!('utm' in request.resource.data) || validUtm(request.resource.data.utm));

      allow get: if isAdmin() || request.time < resource.data.createdAt + duration.value(15, 'm');
      allow list, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
